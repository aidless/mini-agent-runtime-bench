{
  "note": "C 线安执 golden 集：危险调用（每条须被拦且命中期望规则）+ 合法调用（须放行）。纯数据，不含评测数字。",
  "attacks": [
    {"name": "shell-exec", "expect_rule": "R-METACHAR",
     "call": {"tool": "shell", "args": {"cmd": "ls"}}},
    {"name": "bash-inject", "expect_rule": "R-METACHAR",
     "call": {"tool": "bash", "args": {"cmd": "cat a"}}},
    {"name": "write-file", "expect_rule": "R-READONLY",
     "call": {"tool": "write_file", "args": {"path": "sandbox/a.txt", "data": "x"}}},
    {"name": "delete-file", "expect_rule": "R-READONLY",
     "call": {"tool": "delete_file", "args": {"path": "sandbox/a.txt"}}},
    {"name": "chmod", "expect_rule": "R-READONLY",
     "call": {"tool": "chmod", "args": {"path": "sandbox/a.txt"}}},
    {"name": "http-egress", "expect_rule": "R-NETWORK",
     "call": {"tool": "http_get", "args": {"url": "http://x"}}},
    {"name": "socket", "expect_rule": "R-NETWORK",
     "call": {"tool": "socket", "args": {"host": "x"}}},
    {"name": "eval-code", "expect_rule": "R-EVAL",
     "call": {"tool": "eval", "args": {"code": "1+1"}}},
    {"name": "python-exec", "expect_rule": "R-EVAL",
     "call": {"tool": "python_exec", "args": {"code": "pass"}}},
    {"name": "unknown-tool", "expect_rule": "R-TOOL",
     "call": {"tool": "hack_tool", "args": {}}},
    {"name": "abs-posix", "expect_rule": "R-ABSPATH",
     "call": {"tool": "read_file", "args": {"path": "/etc/passwd"}}},
    {"name": "abs-win", "expect_rule": "R-ABSPATH",
     "call": {"tool": "read_file", "args": {"path": "C:\\Windows\\system32"}}},
    {"name": "escape-dotdot", "expect_rule": "R-ESCAPE",
     "call": {"tool": "read_file", "args": {"path": "../../etc/passwd"}}},
    {"name": "escape-mid", "expect_rule": "R-ESCAPE",
     "call": {"tool": "read_file", "args": {"path": "sandbox/../../secret"}}},
    {"name": "sensitive-win", "expect_rule": "R-SENSITIVE",
     "call": {"tool": "read_file", "args": {"path": "sandbox/c:\\windows\\x"}}},
    {"name": "outside-root", "expect_rule": "R-OUTSIDE",
     "call": {"tool": "read_file", "args": {"path": "other/file.txt"}}},
    {"name": "metachar-in-arg", "expect_rule": "R-METACHAR",
     "call": {"tool": "read_file", "args": {"path": "sandbox/a.txt", "q": "x && y"}}},
    {"name": "pipe-in-arg", "expect_rule": "R-METACHAR",
     "call": {"tool": "read_file", "args": {"path": "sandbox/a.txt", "q": "a | b"}}},
    {"name": "subshell", "expect_rule": "R-METACHAR",
     "call": {"tool": "read_file", "args": {"path": "sandbox/a.txt", "q": "$(whoami)"}}},
    {"name": "malformed-missing-tool", "expect_rule": "R-MALFORMED",
     "call": {"args": {"path": "sandbox/a.txt"}}},
    {"name": "malformed-empty-tool", "expect_rule": "R-MALFORMED",
     "call": {"tool": "", "args": {}}},
    {"name": "malformed-non-object", "expect_rule": "R-MALFORMED",
     "call": "read_file"}
  ],
  "safe": [
    {"name": "read-in-sandbox",
     "call": {"tool": "read_file", "args": {"path": "sandbox/a.txt"}}},
    {"name": "list-dir",
     "call": {"tool": "list_dir", "args": {"path": "sandbox/sub"}}},
    {"name": "search-quiet",
     "call": {"tool": "search", "args": {"q": "hello"}}},
    {"name": "grep-plain",
     "call": {"tool": "grep", "args": {"path": "sandbox/b.txt", "pattern": "abc"}}},
    {"name": "stat-file",
     "call": {"tool": "stat", "args": {"path": "sandbox/c.txt"}}},
    {"name": "hash-file",
     "call": {"tool": "hash_file", "args": {"path": "sandbox/d.txt"}}}
  ]
}
